{
  "palette": {
    "colors": ["#3b3f45", "#8a7f70", "#c9c2b4", "#2a4a3c"],
    "accent": "#d9a441"
  },
  "surfaces": {
    "floor": {
      "material": "Slate",
      "color": "#3b3f45"
    },
    "wall": {
      "material": "Brick",
      "color": "#8a7f70"
    },
    "trim": {
      "material": "Metal",
      "color": "#2a4a3c"
    },
    "ceiling": {
      "material": "Concrete",
      "color": "#c9c2b4"
    },
    "accent": {
      "material": "Metal",
      "color": "#d9a441"
    }
  },
  "lighting": {
    "LightingStyle": "Realistic",
    "PrioritizeLightingQuality": true,
    "Ambient": "#4a4740",
    "OutdoorAmbient": "#6b7280",
    "Brightness": 3,
    "ExposureCompensation": 0.2,
    "EnvironmentDiffuseScale": 0.6,
    "EnvironmentSpecularScale": 0.5,
    "ShadowSoftness": 0.3,
    "Atmosphere": {
      "Density": 0.25,
      "Offset": 0.1,
      "Color": "#c9c2b4",
      "Decay": "#8a7f70",
      "Glare": 0.1,
      "Haze": 1
    },
    "Bloom": {
      "Intensity": 0.3,
      "Size": 20,
      "Threshold": 1.6
    }
  },
  "lightingIntent": "bright and even overhead light with crisp shadows",
  "lightRoles": {
    "zoneMarker": {
      "range": 30,
      "brightness": 0.3,
      "color": "#f2d9a0"
    },
    "focal": {
      "range": 45,
      "brightness": 0.45,
      "color": "#ffe6b0"
    },
    "hero": {
      "range": 80,
      "brightness": 0.625,
      "color": "#fff1cf"
    }
  },
  "propKit": ["bench", "lamp", "pillar", "stairs", "rail"],
  "propRules": {
    "bench": { "heightRatio": { "min": 0.34, "max": 0.75 }, "freeRotation": false },
    "lamp": { "heightRatio": { "min": 1.03, "max": 2.25 }, "freeRotation": false },
    "pillar": { "freeRotation": false },
    "stairs": { "heightRatio": { "min": 0.34, "max": 0.75 }, "freeRotation": false },
    "rail": { "heightRatio": { "min": 0.34, "max": 0.75 }, "freeRotation": false },
    "departure-board": { "heightRatio": { "min": 1.15, "max": 2.5 }, "freeRotation": false },
    "clock": { "heightRatio": { "min": 1.26, "max": 2.75 }, "freeRotation": false },
    "ticket-machine": { "heightRatio": { "min": 0.69, "max": 1.5 }, "freeRotation": false },
    "track-bed": { "heightRatio": { "min": 0.11, "max": 0.25 }, "freeRotation": false },
    "platform-edge": { "heightRatio": { "min": 0.05, "max": 0.13 }, "freeRotation": false },
    "ticket-counter": { "heightRatio": { "min": 0.92, "max": 2.0 }, "freeRotation": false }
  },
  "roomTypes": {
    "concourse": {
      "setPieces": ["bench", "departure-board", "clock"],
      "arrangements": [
        { "shape": "grid", "piece": "pillar", "spacing": 12 },
        { "shape": "rows", "piece": "bench", "spacing": 6, "perRow": 3 },
        {
          "shape": "along-walls",
          "piece": "ticket-machine",
          "spacing": 5,
          "walls": "doorless",
          "inset": 2,
          "max": 3
        }
      ],
      "signLabel": "CONCOURSE",
      "roomNames": ["waiting area", "hall", "station hall", "lobby"]
    },
    "platform": {
      "setPieces": ["track-bed", "platform-edge"],
      "arrangements": [
        { "shape": "along-length", "piece": "lamp", "spacing": 8, "inset": 1 },
        { "shape": "along-length", "piece": "bench", "spacing": 8, "inset": 5 },
        { "shape": "along-length", "piece": "pillar", "spacing": 8, "inset": 10 },
        { "shape": "along-length", "piece": "bench", "spacing": 8, "inset": 15 }
      ],
      "signLabel": "PLATFORM 1",
      "roomNames": ["track", "station platform"]
    },
    "ticket-hall": {
      "setPieces": ["ticket-counter"],
      "arrangements": [
        { "shape": "along-walls", "piece": "bench", "spacing": 6, "walls": "doorless", "inset": 2 },
        { "shape": "rows", "piece": "rail", "spacing": 4, "perRow": 3 },
        { "shape": "grid", "piece": "lamp", "spacing": 7 },
        {
          "shape": "along-walls",
          "piece": "ticket-machine",
          "spacing": 3,
          "walls": "doorless",
          "inset": 2
        }
      ],
      "signLabel": "TICKETS",
      "roomNames": ["ticket counter", "ticket office", "booking hall"]
    }
  },
  "sizeRules": {
    "agentRadius": 2,
    "agentHeight": 5,
    "minDoorwayWidth": 10,
    "minHallwayWidth": 12,
    "minWallHeight": 16,
    "avatarHeight": { "min": 5, "max": 6.5 }
  }
}
